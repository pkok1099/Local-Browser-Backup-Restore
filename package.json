{
  "name": "local-browser-backup-extension",
  "version": "1.4.8",
  "description": "Backup & restore browser data locally or to GitHub, with encryption, daily or weekly scheduling, retry controls, and token-safe settings transfer. No server or telemetry.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "screenshot": "npm run build && node scripts/screenshot.mjs",
    "compile": "tsc --noEmit",
    "prepare": "husky",
    "test:node": "node --test tests/cloud/*.mjs tests/restore/*.mjs tests/collect/*.mjs tests/sitedata/*.mjs tests/crypto/*.mjs tests/dashboard/*.mjs tests/safety/*.mjs",
    "test:ui": "node tests/extension-ui.mjs",
    "test:e2e": "node --test tests/e2e/local-roundtrip.mjs tests/e2e/cloud-roundtrip.mjs tests/e2e/scheduler-roundtrip.mjs tests/e2e/sitedata-tabs.mjs tests/e2e/sitedata-error-tabs.mjs tests/e2e/sitedata-blocking.mjs tests/e2e/cookies-partitioned.mjs tests/e2e/theme-toggle.mjs",
    "test": "npm run test:node",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "cycles": "madge --circular --extensions js,jsx,ts,tsx --ts-config tsconfig.madge.json src",
    "knip": "knip",
    "test:cloud": "node --test tests/cloud/*.mjs",
    "test:restore": "node --test tests/restore/*.mjs",
    "test:collect": "node --test tests/collect/*.mjs",
    "test:sitedata": "node --test tests/sitedata/*.mjs",
    "test:crypto": "node --test tests/crypto/*.mjs",
    "test:dashboard": "node --test tests/dashboard/*.mjs",
    "test:safety": "node --test tests/safety/*.mjs"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lucide-react": "^1.49.0",
    "madge": "^8.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
